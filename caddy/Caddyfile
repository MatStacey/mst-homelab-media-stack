# LAN-only pseudo-domain for now. Resolve *.media.lan via hosts-file entries or LAN DNS.
# Each site is prefixed with http:// so Caddy serves it as plain HTTP on port 80 and skips
# automatic HTTPS for it (bare hostnames default to HTTPS-only on :443, which fails forever
# trying to get a public ACME cert for a non-public .lan name). Swap to a real domain later:
# drop the http:// prefix, add an `email` directive, and automatic HTTPS takes over.

http://sonarr.media.lan {
	reverse_proxy sonarr:8989
}

http://radarr.media.lan {
	reverse_proxy radarr:7878
}

http://prowlarr.media.lan {
	reverse_proxy prowlarr:9696
}

http://bazarr.media.lan {
	reverse_proxy bazarr:6767
}

http://jellyfin.media.lan {
	reverse_proxy jellyfin:8096
}

http://jellyseerr.media.lan {
	reverse_proxy jellyseerr:5055
}

http://qbittorrent.media.lan {
	reverse_proxy qbittorrent:8080
}
