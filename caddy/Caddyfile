# LAN-only pseudo-domain: *.media.lan isn't a publicly-resolvable domain, so it can never
# get a real Let's Encrypt certificate. `local_certs` tells Caddy to use its own internal CA
# for every site below instead - it self-signs a cert per hostname and still gets you HTTPS
# (with an automatic http->https redirect), but every device needs that CA's root certificate
# installed as trusted or it'll show a certificate warning. After bringing the stack up, grab
# the root cert from config/caddy/data/caddy/pki/authorities/local/root.crt and install it as
# a trusted root CA on each device that will access these sites (see README's TLS notes) - some
# devices (smart TVs, some apps) can't accept a custom CA at all and will need to keep using
# qBittorrent's/Jellyfin's own published ports directly instead.
{
	local_certs
}

sonarr.media.lan {
	reverse_proxy sonarr:8989
}

radarr.media.lan {
	reverse_proxy radarr:7878
}

prowlarr.media.lan {
	reverse_proxy prowlarr:9696
}

bazarr.media.lan {
	reverse_proxy bazarr:6767
}

jellyfin.media.lan {
	reverse_proxy jellyfin:8096
}

seerr.media.lan {
	reverse_proxy seerr:5055
}

qbittorrent.media.lan {
	reverse_proxy qbittorrent:8080
}

# Static landing page - a simple tile grid linking to every service, so
# people who just want to watch/request something don't need to know each
# service's own address. The full live-stats dashboard (what used to be
# here) moved to admin.media.lan - Homepage (a Next.js app) doesn't support
# being served under a subpath like homepage.media.lan/admin, only its own
# domain root, so it needed a separate hostname rather than a path.
homepage.media.lan {
	root * /srv/landing
	file_server
}

admin.media.lan {
	reverse_proxy homepage:3000
}

# Same landing page, reachable by raw IP with no hostname/DNS/certificate
# needed - for devices that can't resolve *.media.lan (see README's LAN
# access notes) or don't handle the local CA. Plain HTTP, no TLS: an IP
# address can't get a real per-hostname cert the way local_certs issues one
# above, and Caddy's automatic HTTPS would just redirect-then-fail for it.
:8888 {
	root * /srv/landing
	file_server
}
