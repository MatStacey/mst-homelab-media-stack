# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Feature flag: toggle Gluetun/VPN on or off here ---
# "novpn"  -> qBittorrent connects directly (no VPN dependency)
# "vpn"    -> qBittorrent's traffic is routed through Gluetun (requires the VPN_* vars below)
COMPOSE_PROFILES=novpn

# IANA timezone, e.g. Europe/London
TZ=

# --- Only required when COMPOSE_PROFILES=vpn ---
# Gluetun (the container that runs the VPN tunnel) supports 30+ providers, each with
# its own required variables - the full list and exact requirements per provider are at
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
#
# Uncomment ONE of the examples below and fill in your own credentials, or adapt the
# pattern for any other provider Gluetun supports (NordVPN, Surfshark, AirVPN,
# Windscribe, IVPN, ...): set VPN_SERVICE_PROVIDER to that provider's Gluetun name,
# then fill in whichever of VPN_USER/VPN_PASSWORD/WIREGUARD_*/VPN_COUNTRIES/
# VPN_REGIONS/VPN_CITIES its wiki page calls for - unused ones can stay blank.

# -- Private Internet Access (default here - WireGuard, supports port forwarding) --
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers/private-internet-access
VPN_SERVICE_PROVIDER="private internet access"
VPN_TYPE=wireguard
VPN_USER=
VPN_PASSWORD=
VPN_REGIONS=
VPN_PORT_FORWARDING=on

# -- ProtonVPN (OpenVPN credentials from Account > OpenVPN/IKEv2, NOT your Proton login) --
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers/protonvpn
# VPN_SERVICE_PROVIDER=protonvpn
# VPN_TYPE=openvpn
# VPN_USER=
# VPN_PASSWORD=
# VPN_COUNTRIES=

# -- Mullvad (WireGuard only - generate a key at mullvad.net/en/account) --
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers/mullvad
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# VPN_COUNTRIES=

# Your home LAN subnet, e.g. 192.168.1.0/24 — allows LAN clients through Gluetun's firewall
LAN_SUBNET=

# --- Used by scripts/setup.sh (optional) ---
# Shared login for qBittorrent/Sonarr/Radarr/Prowlarr/Bazarr/Jellyfin's web UIs.
# Leave both blank and the script will prompt for them instead of storing them here.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated Prowlarr indexer names to add (must match Prowlarr's built-in indexer
# names exactly). Leave unset to use the script's curated default list, or set to an
# empty string to skip indexer setup entirely.
# PROWLARR_INDEXERS=YTS,Knaben,1337x,EZTV,The Pirate Bay
