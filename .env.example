# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Feature flag: toggle Gluetun/VPN on or off here ---
# "novpn"  -> qBittorrent connects directly (no VPN dependency)
# "vpn"    -> qBittorrent's traffic is routed through Gluetun (requires PIA_* vars below)
COMPOSE_PROFILES=novpn

# IANA timezone, e.g. Europe/London
TZ=

# --- Only required when COMPOSE_PROFILES=vpn ---
# Private Internet Access credentials (https://www.privateinternetaccess.com)
PIA_USER=
PIA_PASSWORD=

# PIA region name, e.g. "Netherlands", "UK London" — see:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers/private-internet-access
PIA_REGION=

# Your home LAN subnet, e.g. 192.168.1.0/24 — allows LAN clients through Gluetun's firewall
LAN_SUBNET=

# --- Used by scripts/setup.sh (optional) ---
# Shared login for qBittorrent/Sonarr/Radarr/Prowlarr/Bazarr/Jellyfin's web UIs.
# Leave both blank and the script will prompt for them instead of storing them here.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated Prowlarr indexer names to add (must match Prowlarr's built-in indexer
# names exactly). Leave unset to use the script's curated default list, or set to an
# empty string to skip indexer setup entirely.
# PROWLARR_INDEXERS=YTS,Knaben,1337x,EZTV,The Pirate Bay
